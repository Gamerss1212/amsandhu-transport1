# Copy to .env and fill in.

# Claude API key (https://console.anthropic.com) - powers the clip analysis and strict judge.
ANTHROPIC_API_KEY=

# YouTube Data API v3 key (https://console.cloud.google.com) - search, stats, comments.
# Without it the app falls back to yt-dlp search + RSS, with fewer signals.
YOUTUBE_API_KEY=

# Apify token (https://apify.com) - collects TikTok + Instagram data for the trend analysis.
APIFY_TOKEN=
