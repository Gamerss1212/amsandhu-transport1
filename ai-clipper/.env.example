# ALL KEYS ARE OPTIONAL. AI Clipper works without any of them.
# Add one only if you want that extra.

# Claude API key (https://console.anthropic.com) - adds Claude as an extra AI judge on top of the
# free built-in judge.
ANTHROPIC_API_KEY=

# YouTube Data API v3 key (https://console.cloud.google.com) - faster search and more stats.
# Without it the free YouTube search + RSS feeds are used.
YOUTUBE_API_KEY=

# Apify token (https://apify.com) - adds real TikTok + Instagram data to the trend analysis.
# Without it the analysis uses free YouTube Shorts data.
APIFY_TOKEN=
