# Copy to .env. Never put credentials in chat or in frontend files.
PORT=4317
# Optional local AI. Install Ollama and pull a model yourself, then set its exact name.
OLLAMA_MODEL=
OLLAMA_URL=http://127.0.0.1:11434
# Optional stock market data credentials; no brokerage orders are sent.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Optional Twilio telephone integration. It remains disabled without all fields.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OWNER_PHONE_NUMBER=
# A strong private PIN, 6-12 digits. Used on inbound AND outbound calls.
PHONE_PIN=
# Exact external HTTPS origin. Proxy ONLY /voice/* to this local server.
PUBLIC_VOICE_URL=
# Optional read-only bridge for a separately installed OpenClaw agent; >=32 chars.
BRIDGE_TOKEN=
